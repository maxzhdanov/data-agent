{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Ingestion": {
    "MaximumUploadBytes": 20971520
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Storage": {
    "Target": "MongoDb",
    "CollectionName": "clean_records",
    "Mongo": {
      "ConnectionString": "mongodb://localhost:27017",
      "Database": "finguard"
    },
    "Dynamo": {
      "ServiceUrl": "http://localhost:8001",
      "TableName": "finguard_clean_records",
      "Region": "us-east-1",
      "AccessKey": "local",
      "SecretKey": "local"
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "granite-code:latest",
    "NumPredict": 48,
    "Enabled": true
  },
  "Embeddings": {
    "Model": "nomic-embed-text"
  },
  "Chroma": {
    "BaseUrl": "http://localhost:8000",
    "Collection": "iso-audit-rules"
  },
  "RateLimiting": {
    "TokenLimit": 4,
    "TokensPerPeriod": 2,
    "ReplenishmentPeriodSeconds": 2,
    "QueueLimit": 16
  },
  "Resilience": {
    "RetryCount": 3,
    "RetryBackoffSeconds": 1,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerBreakSeconds": 30
  },
  "PipelineStatePath": "data/pipeline-state.json"
}
