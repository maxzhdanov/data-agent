<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>FinGuardPlatform.PipelineApp</RootNamespace>
    <UserSecretsId>dotnet-FinGuardPlatform.PipelineApp-3b51928a-20b5-4be9-b8ce-ba31dea49e61</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.6.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Resilience" Version="9.0.0" />
    <PackageReference Include="Polly.Core" Version="8.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinGuardPlatform.CoreEngine\FinGuardPlatform.CoreEngine.csproj" />
    <ProjectReference Include="..\FinGuardPlatform.ServiceDefaults\FinGuardPlatform.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\FinGuardPlatform.CoreEngine\Schemas\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Schemas\%(Filename)%(Extension)</Link>
    </None>
    <None Update="samples\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="..\data\iso-rules\**\*">
      <Link>iso-rules\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
